{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "InMemory"
  },
  "ConnectionStrings": {
    "Ledger": ""
  },
  "Projections": {
    "PollingInterval": "00:00:02"
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 100,
    "MaxAttempts": 10
  }
}
